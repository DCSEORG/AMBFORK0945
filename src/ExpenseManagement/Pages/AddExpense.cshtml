@page
@model ExpenseManagement.Pages.AddExpenseModel
@{
    ViewData["Title"] = "Add Expense";
}

<div class="card" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header">
        <h2 class="card-title">Add Expense</h2>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="UserId" />
        
        <div class="form-group">
            <label class="form-label" asp-for="Amount">Amount (£):</label>
            <input type="number" step="0.01" min="0.01" class="form-control" asp-for="Amount" required />
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="ExpenseDate">Date:</label>
            <input type="date" class="form-control" asp-for="ExpenseDate" required />
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="CategoryId">Category:</label>
            <select class="form-control" asp-for="CategoryId" required>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Description">Description:</label>
            <textarea class="form-control" asp-for="Description" rows="4" placeholder="Enter expense description..."></textarea>
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary">Submit</button>
            <a href="/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
