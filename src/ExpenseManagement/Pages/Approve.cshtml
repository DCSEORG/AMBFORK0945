@page
@model ExpenseManagement.Pages.ApproveModel
@{
    ViewData["Title"] = "Approve Expenses";
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Approve Expenses</h2>
    </div>

    <p style="margin-bottom: 1.5rem; color: var(--text-muted);">Pending expenses:</p>

    <form method="get" class="filter-bar">
        <div class="form-group">
            <label class="form-label">Filter:</label>
            <input type="text" name="search" class="form-control" placeholder="Search pending expenses..." 
                   value="@Model.SearchTerm" />
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Submitted By</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PendingExpenses.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 2rem;">
                            No pending expenses to approve.
                        </td>
                    </tr>
                }
                @foreach (var expense in Model.PendingExpenses)
                {
                    <tr>
                        <td>@expense.FormattedDate</td>
                        <td>@expense.CategoryName</td>
                        <td class="amount">@expense.FormattedAmount</td>
                        <td>@expense.UserName</td>
                        <td>@(expense.Description ?? "-")</td>
                        <td class="actions">
                            <form method="post" asp-page-handler="Approve" asp-route-id="@expense.ExpenseId" style="display: inline;">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@expense.ExpenseId" style="display: inline;">
                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
